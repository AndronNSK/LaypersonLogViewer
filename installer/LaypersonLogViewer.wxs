<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Layperson Log Viewer" Manufacturer="Layperson Log Viewer"
           Version="$(var.AppVersion)" Language="$(var.Language)" Codepage="1251"
           Scope="perUser" UpgradeCode="F60DC440-64BF-4C58-B1EA-5F58CDE41947">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Layperson Log Viewer is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="WINDOWSBUILD">
      <RegistrySearch Id="ReadWindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (WINDOWSBUILD &gt;= 10240)" Message="Windows 10 or later is required." />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Layperson Log Viewer" />
      </Directory>
    </StandardDirectory>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ExplorerContextMenu" Guid="*">
        <RegistryKey Root="HKCU" Key="Software\Classes\*\shell\LPLogViewer" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="MUIVerb" Type="string" Value="Открыть в LP LogViewer…" KeyPath="yes" />
          <RegistryValue Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]LaypersonLogViewer.App.exe&quot;,0" />
          <RegistryValue Name="MultiSelectModel" Type="string" Value="Single" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]LaypersonLogViewer.App.exe&quot; --open &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </DirectoryRef>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationMenuFolder" Name="Layperson Log Viewer">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="StartMenuLink" Name="Layperson Log Viewer"
                    Target="[INSTALLFOLDER]LaypersonLogViewer.App.exe" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\LaypersonLogViewer\Installer"
                         Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopLink" Name="Layperson Log Viewer"
                  Target="[INSTALLFOLDER]LaypersonLogViewer.App.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\LaypersonLogViewer\Installer"
                       Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="MainApplication" Title="Layperson Log Viewer" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
    <Feature Id="ExplorerIntegration" Title="Explorer context menu" Level="1" Display="hidden">
      <ComponentRef Id="ExplorerContextMenu" />
    </Feature>
    <Feature Id="DesktopIcon" Title="Desktop shortcut" Level="2">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
    <Property Id="INSTALLLEVEL" Value="1" />
    <Property Id="ADD_EXPLORER_MENU" Value="1" />
    <ui:WixUI Id="WixUI_FeatureTree" />
    <UI>
      <!-- Skip the stock placeholder EULA: this project has no application EULA. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
      <!-- Read the planned feature state, including a choice migrated during an upgrade. -->
      <Publish Dialog="CustomizeDlg" Control="Next" Property="ADD_EXPLORER_MENU" Value="1" Order="2" Condition="&amp;ExplorerIntegration = 3" />
      <Publish Dialog="CustomizeDlg" Control="Next" Property="ADD_EXPLORER_MENU" Value="{}" Order="3" Condition="&amp;ExplorerIntegration &lt;&gt; 3" />
      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="ExplorerOptionsDlg" Order="4" Condition="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ExplorerOptionsDlg" Order="4"
               Condition="NOT Installed OR (WixUI_InstallMode = &quot;Change&quot; AND NOT PATCH)" />
      <Dialog Id="ExplorerOptionsDlg" Width="370" Height="270" Title="!(loc.ExplorerOptionsTitle)">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="!(loc.CustomizeDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="20" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}!(loc.ExplorerOptionsTitle)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="ExplorerMenu" Type="CheckBox" X="20" Y="65" Width="330" Height="30"
                 Property="ADD_EXPLORER_MENU" CheckBoxValue="1" Text="!(loc.ExplorerMenuLabel)" />
        <Control Id="Description" Type="Text" X="20" Y="105" Width="330" Height="60" Text="!(loc.ExplorerMenuDescription)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="CustomizeDlg" Condition="1" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="AddLocal" Value="ExplorerIntegration" Order="1" Condition="ADD_EXPLORER_MENU = &quot;1&quot;" />
          <Publish Event="Remove" Value="ExplorerIntegration" Order="2" Condition="NOT ADD_EXPLORER_MENU" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="3" Condition="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>
    </UI>
  </Package>
</Wix>
