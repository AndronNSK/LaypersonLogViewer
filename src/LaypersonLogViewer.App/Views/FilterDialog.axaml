<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LaypersonLogViewer.App.Views.FilterDialog"
        Width="500" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="12" Spacing="8">
    <TextBlock Name="Heading" FontSize="15" FontWeight="SemiBold" />
    <TextBlock Text="Строка содержит текст:" />
    <TextBox Name="PatternBox" IsReadOnly="False" PlaceholderText="Например: ERROR или ошибка" TextChanged="Pattern_Changed" />
    <CheckBox Name="CaseSensitiveBox" Content="Учитывать регистр" />
    <TextBlock Text="Поиск буквального текста, включая пробелы и знаки препинания."
               TextWrapping="Wrap" Foreground="#526174" FontSize="11" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
      <Button Name="CancelButton" Content="Отмена" IsCancel="True" Click="Cancel_Click" />
      <Button Name="AddButton" Content="Добавить" IsDefault="True" IsEnabled="False" Click="Add_Click" />
    </StackPanel>
  </StackPanel>
</Window>
