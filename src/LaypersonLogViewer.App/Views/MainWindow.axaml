<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LaypersonLogViewer.App.ViewModels"
        xmlns:core="using:LaypersonLogViewer.Core"
        x:Class="LaypersonLogViewer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Layperson · Просмотр журналов" Width="1120" Height="780"
        MinWidth="760" MinHeight="560" Background="#F3F5F8">
  <Grid Margin="24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="140" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="220" MinHeight="160" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Просмотр журналов" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{Binding FileName}" Foreground="#526174" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button Grid.Column="1" Name="OpenFileButton" Content="Открыть файл…" Click="OpenFile_Click"
              IsEnabled="{Binding !IsBusy}" VerticalAlignment="Center" Padding="18,10" />
    </Grid>

    <Border Grid.Row="1" Background="White" BorderBrush="#D9DFE8" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#EAF0F6" Padding="14,9">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Text="СТРОКИ ЖУРНАЛА" FontSize="11" FontWeight="SemiBold" Foreground="#526174" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" Name="ShowFilteredOutSwitch"
                          IsChecked="{Binding ShowFilteredOut, Mode=TwoWay}"
                          OffContent="Скрывать отфильтрованные" OnContent="Отфильтрованные — серым"
                          ToolTip.Tip="Показывать отфильтрованные строки серым, сохраняя контекст" />
          </Grid>
        </Border>
        <ListBox Grid.Row="1" Name="LogLines" ItemsSource="{Binding DisplayLines}" BorderThickness="0"
                 Background="Transparent" SelectionMode="Multiple" FontFamily="Consolas, monospace"
                 FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.AllowAutoHide="False">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="12,3" />
              <Setter Property="MinHeight" Value="24" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogLineRow">
              <Grid Name="LineContent" ColumnDefinitions="64,*" ColumnSpacing="12" Opacity="{Binding Opacity}">
                <TextBlock Text="{Binding Number}" Foreground="#738297" TextAlignment="Right" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="NoWrap"
                                     Background="Transparent" Cursor="Ibeam" ContextRequested="LogText_ContextRequested"
                                     DataContextChanged="LogText_DataContextChanged" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}"
                   IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#738297" />
      </Grid>
    </Border>

    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#D9DFE8"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

    <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#D9DFE8" BorderThickness="1" Padding="16">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="Фильтры" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Name="IncludeButton" Content="Показать строки..." Click="Include_Click" IsEnabled="{Binding !IsBusy}" />
          <Button Grid.Column="2" Name="ExcludeButton" Content="Скрыть строки" Click="Exclude_Click" IsEnabled="{Binding !IsBusy}" />
          <Button Grid.Column="3" Content="Сбросить" Click="Clear_Click" IsEnabled="{Binding !IsBusy}" />
        </Grid>
        <TextBlock Grid.Row="1" Text="Показать: любое совпадение. Скрыть: исключить при любом совпадении."
                   FontSize="12" Foreground="#526174" TextWrapping="Wrap" />
        <Grid Grid.Row="2">
          <ScrollViewer VerticalScrollBarVisibility="Visible" AllowAutoHide="False">
            <ItemsControl ItemsSource="{Binding Filters}" IsEnabled="{Binding !IsBusy}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:LogFilter">
                  <Border Background="#F3F5F8" CornerRadius="4" Padding="10,5" Margin="0,0,0,5">
                    <Grid ColumnDefinitions="80,*,160,Auto" ColumnSpacing="10">
                      <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Text}" />
                      <TextBlock Grid.Column="2" Text="{Binding CaseLabel}" FontSize="12" Foreground="#526174" VerticalAlignment="Center" />
                      <Button Grid.Column="3" Content="Удалить" Click="Remove_Click" Padding="10,4" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="Фильтров пока нет — показаны все строки" IsVisible="{Binding HasNoFilters}"
                     IsHitTestVisible="False" Foreground="#738297" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>

    <StackPanel Grid.Row="4" Spacing="4">
      <TextBlock Text="{Binding Status}" Foreground="#526174" FontSize="12" />
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#B42318" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
