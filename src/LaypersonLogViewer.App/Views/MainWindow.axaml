<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LaypersonLogViewer.App.ViewModels"
        xmlns:core="using:LaypersonLogViewer.Core"
        xmlns:views="using:LaypersonLogViewer.App.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="LaypersonLogViewer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Layperson · Просмотр журналов" Width="1120" Height="780"
        MinWidth="760" MinHeight="560" Background="#F3F5F8"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="30">
  <Window.WindowDecorationsTheme>
    <ControlTheme TargetType="chrome:WindowDrawnDecorations"
                  BasedOn="{StaticResource {x:Type chrome:WindowDrawnDecorations}}">
      <!-- The title's template sets its own margin, so this override needs a style trigger. -->
      <Style Selector="^:has-titlebar /template/ Panel#PART_TitleTextPanel > TextBlock">
        <Setter Property="Margin" Value="44,0,144,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
    </ControlTheme>
  </Window.WindowDecorationsTheme>
  <Window.Styles>
    <Style Selector="Button.panel-grip">
      <Setter Property="Background" Value="#F3F5F8" />
      <Setter Property="BorderBrush" Value="#BAC6D3" />
    </Style>
    <Style Selector="Button.panel-grip:pointerover">
      <Setter Property="Background" Value="#DCE6F0" />
      <Setter Property="BorderBrush" Value="#9DADBE" />
    </Style>
    <Style Selector="Button.panel-grip:pressed">
      <Setter Property="Background" Value="#CBD9E8" />
    </Style>
    <Style Selector="Button.panel-grip.collapsed Path">
      <Setter Property="RenderTransform"><RotateTransform Angle="180" /></Setter>
    </Style>
  </Window.Styles>
  <Window.Resources>
    <views:LogDisplayConverter x:Key="LogDisplayConverter" />
  </Window.Resources>
  <Panel>
  <Border Name="MainContent">
  <Grid Name="MainLayout" Margin="8" RowSpacing="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="140" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="210" MinHeight="150" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Name="MainToolbar" RowDefinitions="Auto,Auto" RowSpacing="2">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <WrapPanel Name="SourceToolbar" VerticalAlignment="Center">
          <Button Name="OpenFileButton" Content="Открыть файл…" Click="OpenFile_Click"
                  IsEnabled="{Binding !IsBusy}" Margin="0,0,4,0"
                  ToolTip.Tip="Открыть файл журнала и следить за новыми строками" />
          <Button Name="StartCommandButton" Content="Запустить команду…" Click="StartCommand_Click"
                  IsEnabled="{Binding !IsBusy}" />
        </WrapPanel>
        <TextBlock Grid.Column="1" Name="SourceName" Text="{Binding FileName}" ToolTip.Tip="{Binding FileName}"
                   Foreground="#526174" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Button Grid.Column="2" Name="SearchButton" Content="Найти…" Click="Search_Click"
                ToolTip.Tip="Поиск в показанных строках (Ctrl+F)" />
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <CheckBox Name="PauseStreamBox" Content="Пауза показа" IsChecked="{Binding Live.IsPaused}"
                    IsEnabled="{Binding Live.HasSession}" />
          <CheckBox Name="FollowLatestBox" Content="Прокрутка" IsChecked="{Binding Live.FollowLatest}"
                    ToolTip.Tip="Следовать за новыми строками. Нажатие на строку отключает прокрутку; прокрутка до конца включает её." />
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <CheckBox Name="FormatJsonBox" Content="Форматировать JSON" Margin="0,0,8,0"
                    IsChecked="{Binding FormatJson, Mode=TwoWay}" VerticalAlignment="Center"
                    ToolTip.Tip="Показывать JSON с отступом в два пробела" />
          <CheckBox Name="WordWrapBox" Content="Перенос строк" Margin="0,0,8,0"
                    IsChecked="{Binding WordWrap, Mode=TwoWay}" VerticalAlignment="Center"
                    ToolTip.Tip="Переносить длинные строки по ширине окна" />
          <ToggleSwitch Name="ShowFilteredOutSwitch" VerticalAlignment="Center"
                        IsChecked="{Binding ShowFilteredOut, Mode=TwoWay}"
                        OffContent="Скрывать отфильтрованные" OnContent="Отфильтрованные — серым"
                        ToolTip.Tip="Показывать отфильтрованные строки серым, сохраняя контекст">
            <ToggleSwitch.Resources>
              <GridLength x:Key="ToggleSwitchPreContentMargin">1</GridLength>
              <GridLength x:Key="ToggleSwitchPostContentMargin">1</GridLength>
            </ToggleSwitch.Resources>
          </ToggleSwitch>
        </WrapPanel>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Background="White" BorderBrush="#D9DFE8" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Grid Name="SearchBar" IsVisible="{Binding Search.IsVisible}" Margin="4" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="4">
          <TextBox Name="SearchTextBox" Text="{Binding Search.Text, Mode=TwoWay}"
                   PlaceholderText="Поиск в показанных строках" MinWidth="120" />
          <CheckBox Name="SearchCaseBox" Grid.Column="1" Content="Регистр" IsChecked="{Binding Search.CaseSensitive, Mode=TwoWay}"
                    ToolTip.Tip="Учитывать регистр" />
          <Button Name="SearchPreviousButton" Grid.Column="2" Content="↑" Click="SearchPrevious_Click" IsEnabled="{Binding Search.CanSearch}"
                  AutomationProperties.Name="Предыдущее совпадение" ToolTip.Tip="Предыдущее совпадение (Shift+F3)" />
          <Button Name="SearchNextButton" Grid.Column="3" Content="↓" Click="SearchNext_Click" IsEnabled="{Binding Search.CanSearch}"
                  AutomationProperties.Name="Следующее совпадение" ToolTip.Tip="Следующее совпадение (F3 или Enter)" />
          <TextBlock Name="SearchStatus" Grid.Column="4" Text="{Binding Search.Status}" Width="180" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Search.Status}" VerticalAlignment="Center" Foreground="#526174" />
          <Button Name="CloseSearchButton" Grid.Column="5" Content="×" Click="CloseSearch_Click"
                  AutomationProperties.Name="Закрыть поиск" ToolTip.Tip="Закрыть поиск (Escape)" />
        </Grid>
        <ListBox Name="LogLines" Grid.Row="1" ItemsSource="{Binding DisplayLines}" BorderThickness="0"
                 Background="Transparent" SelectionMode="Multiple" FontFamily="Consolas, monospace"
                 FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="{Binding LogHorizontalScrollBarVisibility}"
                 ScrollViewer.BringIntoViewOnFocusChange="False"
                 ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.AllowAutoHide="False">
          <ListBox.Resources>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
          </ListBox.Resources>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="6,0" />
              <Setter Property="MinHeight" Value="16" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogLineRow">
              <Border BorderBrush="#D9DFE8" BorderThickness="{Binding SeparatorThickness}">
              <Grid Name="LineContent" ColumnDefinitions="64,*" ColumnSpacing="8" Opacity="{Binding Opacity}">
                <Border Name="LogLineNumber" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{Binding #RowSearchHighlight.NumberBackground}" CornerRadius="2">
                  <TextBlock Text="{Binding Number}" Foreground="#526174" TextAlignment="Right" LineHeight="16" />
                </Border>
                <TextBox Name="LogRowText" Grid.Column="1" LineHeight="16"
                                     TextWrapping="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LogTextWrapping}"
                                     IsReadOnly="True" ClearSelectionOnLostFocus="False"
                                     IsInactiveSelectionHighlightEnabled="True"
                                     Padding="0" BorderThickness="0" MinHeight="0"
                                     Background="Transparent" Cursor="Ibeam" ContextRequested="LogText_ContextRequested"
                                     GotFocus="LogText_GotFocus" DataContextChanged="LogText_DataContextChanged">
                  <TextBox.Text>
                    <MultiBinding Converter="{StaticResource LogDisplayConverter}">
                      <Binding Path="." />
                      <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).FormatJson" />
                    </MultiBinding>
                  </TextBox.Text>
                </TextBox>
                <views:LogSearchHighlight Name="RowSearchHighlight" Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True"
                    Target="{Binding #LogRowText}" Row="{Binding}"
                    FormatJson="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).FormatJson}"
                    Query="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Search.HighlightText}"
                    CaseSensitive="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Search.CaseSensitive}"
                    CurrentMatch="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Search.CurrentMatch}" />
              </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}"
                   IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#738297" />
      </Grid>
    </Border>

    <GridSplitter Name="LowerPaneDivider" Grid.Row="2" Height="5" VerticalAlignment="Center"
                  HorizontalAlignment="Stretch" Background="#D9DFE8"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
    <Button Name="LowerPaneToggle" Classes="panel-grip" Grid.Row="2" Click="LowerPaneToggle_Click"
            Width="64" Height="18" MinHeight="0" MinWidth="0" Padding="0"
            BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
            AutomationProperties.Name="Показать или скрыть панель вкладок"
            ToolTip.Tip="Скрыть панель вкладок">
      <Button.Template>
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Button.Template>
      <StackPanel Orientation="Horizontal" Spacing="6" IsHitTestVisible="False">
        <Rectangle Width="14" Height="2" Fill="#9DADBE" VerticalAlignment="Center" />
        <Path Name="LowerPaneChevron" Width="10" Height="6" Data="M 1,1 L 5,5 L 9,1"
              Stroke="#526174" StrokeThickness="1.5" />
        <Rectangle Width="14" Height="2" Fill="#9DADBE" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <Border Name="LowerPane" Grid.Row="3" Background="White" CornerRadius="4" BorderBrush="#D9DFE8" BorderThickness="1" Padding="8">
      <TabControl Name="LowerTabs">
        <TabControl.Styles>
          <Style Selector="TabItem">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="12,1" />
            <Setter Property="Margin" Value="0,0,4,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#EFF2F6" />
            <Setter Property="Foreground" Value="#39485C" />
            <Setter Property="BorderBrush" Value="#BCC7D4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
              <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </ControlTemplate>
            </Setter>
          </Style>
          <Style Selector="TabItem:pointerover">
            <Setter Property="Background" Value="#E3EAF4" />
            <Setter Property="BorderBrush" Value="#7B97BC" />
          </Style>
          <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#DDEBFF" />
            <Setter Property="Foreground" Value="#163D70" />
            <Setter Property="BorderBrush" Value="#3974C5" />
          </Style>
        </TabControl.Styles>
        <TabItem Header="Фильтры">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="4">
        <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
          <Button Name="IncludeButton" Content="Показать строки…" Click="Include_Click" Margin="0,0,4,2" />
          <Button Name="ExcludeButton" Content="Скрыть строки…" Click="Exclude_Click" Margin="0,0,4,2" />
          <Button Content="Сбросить" Click="Clear_Click" Margin="0,0,4,2" />
          <Button Name="LoadFiltersButton" Content="Загрузить…" Click="LoadFilters_Click" Margin="0,0,4,2"
                  ToolTip.Tip="Заменить текущие фильтры группами из файла" />
          <Button Name="SaveFiltersButton" Content="Сохранить…" Click="SaveFilters_Click" Margin="0,0,0,2"
                  ToolTip.Tip="Сохранить все группы фильтров в файл" />
        </WrapPanel>
        <TextBlock Grid.Row="1" Text="{Binding FilterExplanation}"
                   FontSize="11" Foreground="#526174" TextWrapping="Wrap" />
        <Grid Grid.Row="2">
          <ScrollViewer VerticalScrollBarVisibility="Visible" AllowAutoHide="False">
            <ItemsControl ItemsSource="{Binding Filters}" IsEnabled="{Binding !IsBusy}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:LogFilter">
                  <Border Background="#F3F5F8" CornerRadius="3" Padding="6,2" Margin="0,0,0,2">
                    <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="70,*,140,Auto,Auto" ColumnSpacing="6">
                      <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Text}" />
                      <TextBlock Grid.Column="2" Text="{Binding CaseLabel}" FontSize="11" Foreground="#526174" VerticalAlignment="Center" />
                      <Button Grid.Column="3" Name="AddConditionButton" Content="Добавить условие…" Click="AddCondition_Click" Padding="8,2" />
                      <Button Grid.Column="4" Name="RemoveFilterButton" Content="Удалить" Click="Remove_Click" Padding="8,2" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding AdditionalConditions}" Margin="20,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:LogFilterCondition">
                          <Grid ColumnDefinitions="90,*,140,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                            <TextBlock Text="И содержит" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Text}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding CaseLabel}" FontSize="11"
                                       Foreground="#526174" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Name="RemoveConditionButton" Content="Удалить"
                                    Click="RemoveCondition_Click" Padding="8,2" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="Фильтров пока нет — показаны все строки" IsVisible="{Binding HasNoFilters}"
                     IsHitTestVisible="False" Foreground="#738297" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
      </Grid>
        </TabItem>
        <TabItem Header="Статистика" Name="StatisticsTab">
          <views:StatisticsPanel DataContext="{Binding Statistics}" />
        </TabItem>
        <TabItem Header="Время записей" Name="TimestampTab">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Name="TimestampDescription" Text="{Binding GroupingDescription}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="#526174" />
                <Button Grid.Column="1" Name="ResetTimestampButton" Content="Сбросить шаблон"
                        IsVisible="{Binding HasTimestampPattern}" IsEnabled="{Binding !IsBusy}"
                        Click="ResetTimestamp_Click" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HasTimestampPattern}">
                <TextBlock Text="Образец:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Name="TimestampExample" Text="{Binding TimestampPattern.Example, Mode=OneWay}"
                         IsReadOnly="True" FontFamily="Consolas, monospace" Padding="4,1" MinHeight="22" />
              </Grid>
              <TextBlock Name="TimestampEntrySummary" Text="{Binding TimestampEntrySummary}" IsVisible="{Binding HasTimestampPattern}" />
              <TextBlock Name="TimestampWarning" Text="{Binding GroupingWarning}" IsVisible="{Binding HasGroupingWarning}"
                         Foreground="#986000" TextWrapping="Wrap" />
              <TextBlock Text="Каждый # — цифра 0–9. Остальные символы и позиция в строке должны совпадать. Значение даты не проверяется."
                         TextWrapping="Wrap" Foreground="#526174" FontSize="11" />
              <TextBlock Text="Совпавшая строка начинает новую запись; следующие строки относятся к ней до нового совпадения. Чтобы изменить шаблон, выделите другой образец времени в журнале и выберите первый пункт контекстного меню."
                         TextWrapping="Wrap" Foreground="#526174" FontSize="11" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Border>

    <StackPanel Grid.Row="4" Spacing="2">
      <TextBlock Text="{Binding Status}" ToolTip.Tip="{Binding Status}" Foreground="#526174" FontSize="11"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#B42318" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
  </Border>
    <Button Name="MainMenuButton" Width="30" Height="24" Padding="0" Background="Transparent"
            HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" ToolTip.Tip="Главное меню"
            AutomationProperties.Name="Главное меню" WindowDecorationProperties.ElementRole="User">
      <Path Data="M 1,1 L 15,1 M 1,6 L 15,6 M 1,11 L 15,11"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
            StrokeThickness="1.5" />
      <Button.Flyout>
        <MenuFlyout Placement="BottomEdgeAlignedLeft">
          <MenuItem Header="_Файл">
            <MenuItem Header="Открыть файл…" Click="OpenFile_Click" IsEnabled="{Binding !IsBusy}" />
            <MenuItem Header="Запустить команду…" Click="StartCommand_Click" IsEnabled="{Binding !IsBusy}" />
            <MenuItem Header="Стоп" Click="StopStream_Click" IsEnabled="{Binding Live.IsActive}" />
            <MenuItem Header="Сохранить журнал…" Click="SaveLog_Click" />
            <MenuItem Header="Настройки…" Click="SettingsMenu_Click" />
            <Separator />
            <MenuItem Header="Выход" Click="ExitMenu_Click" />
          </MenuItem>
          <MenuItem Header="_Вид">
            <MenuItem Header="Найти…" InputGesture="Ctrl+F" Click="Search_Click" />
            <Separator />
            <MenuItem Header="Перенос строк" ToggleType="CheckBox" IsChecked="{Binding WordWrap, Mode=TwoWay}" />
            <MenuItem Header="Показывать отфильтрованные серым" ToggleType="CheckBox"
                      IsChecked="{Binding ShowFilteredOut, Mode=TwoWay}" />
            <MenuItem Header="Панель вкладок" ToggleType="CheckBox" IsChecked="{Binding #LowerPane.IsVisible, Mode=OneWay}"
                      Click="LowerPaneToggle_Click" />
          </MenuItem>
          <MenuItem Header="_Справка">
            <MenuItem Header="Горячие клавиши" Click="KeyboardShortcutsMenu_Click" />
            <MenuItem Header="О программе" Click="AboutMenu_Click" />
          </MenuItem>
        </MenuFlyout>
      </Button.Flyout>
    </Button>
  </Panel>
</Window>
