<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LaypersonLogViewer.App.ViewModels"
        xmlns:core="using:LaypersonLogViewer.Core"
        xmlns:views="using:LaypersonLogViewer.App.Views"
        x:Class="LaypersonLogViewer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Layperson · Просмотр журналов" Width="1120" Height="780"
        MinWidth="760" MinHeight="560" Background="#F3F5F8">
  <Grid Margin="8" RowSpacing="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="140" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="210" MinHeight="150" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="2">
      <TextBlock Text="Просмотр журналов" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding FileName}" ToolTip.Tip="{Binding FileName}"
                 Foreground="#526174" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <Button Grid.Column="2" Name="OpenFileButton" Content="Открыть файл…" Click="OpenFile_Click"
              IsEnabled="{Binding !IsBusy}" VerticalAlignment="Center" />
      <WrapPanel Grid.Row="1" Grid.ColumnSpan="3">
        <Button Name="FollowFileButton" Content="Следить за файлом…" Click="FollowFile_Click" IsEnabled="{Binding !IsBusy}" Margin="0,0,4,0" />
        <Button Name="StartCommandButton" Content="Запустить команду…" Click="StartCommand_Click" IsEnabled="{Binding !IsBusy}" Margin="0,0,4,0" />
        <Button Name="StopStreamButton" Content="Стоп" Click="StopStream_Click" IsEnabled="{Binding Live.IsActive}" Margin="0,0,4,0" />
        <Button Name="SaveLogButton" Content="Сохранить журнал…" Click="SaveLog_Click" Margin="0,0,8,0" />
        <CheckBox Name="PauseStreamBox" Content="Пауза показа" IsChecked="{Binding Live.IsPaused}" IsEnabled="{Binding Live.HasSession}" Margin="0,0,8,0" />
        <CheckBox Name="FollowLatestBox" Content="Прокрутка" IsChecked="{Binding Live.FollowLatest}" Margin="0,0,8,0"
                  ToolTip.Tip="Следовать за новыми строками. Нажатие на строку отключает прокрутку; прокрутка до конца включает её." />
        <TextBlock Text="Лимит строк:" VerticalAlignment="Center" Margin="0,0,4,0" />
        <NumericUpDown Name="RetainedLinesBox" Value="{Binding Live.RetainedLines}" Minimum="100" Maximum="1000000" Increment="1000"
                       Width="110" FormatString="0" ToolTip.Tip="Лимит для потоковых источников; старые строки удаляются. Статистика — по строкам в памяти." />
      </WrapPanel>
      <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Live.Status}" IsVisible="{Binding Live.HasSession}"
                 FontSize="11" Foreground="#526174" TextWrapping="Wrap" />
    </Grid>

    <Border Grid.Row="1" Background="White" BorderBrush="#D9DFE8" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Border Name="LogHeader" Background="#EAF0F6" Padding="8,2">
          <Border.Resources>
            <GridLength x:Key="ToggleSwitchPreContentMargin">2</GridLength>
            <GridLength x:Key="ToggleSwitchPostContentMargin">2</GridLength>
          </Border.Resources>
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="СТРОКИ ЖУРНАЛА" FontSize="11" FontWeight="SemiBold" Foreground="#526174" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding GroupingDescription}" ToolTip.Tip="{Binding GroupingDescription}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" Foreground="#526174" />
            <Button Grid.Column="2" Name="ResetTimestampButton" Content="Сбросить шаблон"
                    IsVisible="{Binding HasTimestampPattern}" IsEnabled="{Binding !IsBusy}"
                    MinHeight="24" Padding="8,1" VerticalAlignment="Center" Click="ResetTimestamp_Click" />
            <ToggleSwitch Grid.Column="3" Name="ShowFilteredOutSwitch" VerticalAlignment="Center"
                          IsChecked="{Binding ShowFilteredOut, Mode=TwoWay}"
                          OffContent="Скрывать отфильтрованные" OnContent="Отфильтрованные — серым"
                          ToolTip.Tip="Показывать отфильтрованные строки серым, сохраняя контекст" />
          </Grid>
        </Border>
        <ListBox Grid.Row="1" Name="LogLines" ItemsSource="{Binding DisplayLines}" BorderThickness="0"
                 Background="Transparent" SelectionMode="Multiple" FontFamily="Consolas, monospace"
                 FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.BringIntoViewOnFocusChange="False"
                 ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.AllowAutoHide="False">
          <ListBox.Resources>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
          </ListBox.Resources>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="6,0" />
              <Setter Property="MinHeight" Value="20" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogLineRow">
              <Border BorderBrush="#D9DFE8" BorderThickness="{Binding SeparatorThickness}">
              <Grid Name="LineContent" ColumnDefinitions="64,*" ColumnSpacing="8" Opacity="{Binding Opacity}">
                <TextBlock Text="{Binding Number}" Foreground="#738297" TextAlignment="Right" />
                <TextBox Grid.Column="1" Text="{Binding Text, Mode=OneWay}" TextWrapping="NoWrap"
                                     IsReadOnly="True" ClearSelectionOnLostFocus="False"
                                     IsInactiveSelectionHighlightEnabled="True"
                                     Padding="0" BorderThickness="0" MinHeight="0"
                                     Background="Transparent" Cursor="Ibeam" ContextRequested="LogText_ContextRequested"
                                     GotFocus="LogText_GotFocus" DataContextChanged="LogText_DataContextChanged" />
              </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}"
                   IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#738297" />
      </Grid>
    </Border>

    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#D9DFE8"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

    <Border Grid.Row="3" Background="White" CornerRadius="4" BorderBrush="#D9DFE8" BorderThickness="1" Padding="8">
      <TabControl Name="LowerTabs">
        <TabControl.Styles>
          <Style Selector="TabItem">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
          </Style>
        </TabControl.Styles>
        <TabItem Header="Фильтры">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="4">
        <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
          <Button Name="IncludeButton" Content="Показать строки…" Click="Include_Click" Margin="0,0,4,2" />
          <Button Name="ExcludeButton" Content="Скрыть строки…" Click="Exclude_Click" Margin="0,0,4,2" />
          <Button Content="Сбросить" Click="Clear_Click" Margin="0,0,4,2" />
          <Button Name="LoadFiltersButton" Content="Загрузить…" Click="LoadFilters_Click" Margin="0,0,4,2"
                  ToolTip.Tip="Заменить текущие фильтры группами из файла" />
          <Button Name="SaveFiltersButton" Content="Сохранить…" Click="SaveFilters_Click" Margin="0,0,0,2"
                  ToolTip.Tip="Сохранить все группы фильтров в файл" />
        </WrapPanel>
        <TextBlock Grid.Row="1" Text="{Binding FilterExplanation}"
                   FontSize="11" Foreground="#526174" TextWrapping="Wrap" />
        <Grid Grid.Row="2">
          <ScrollViewer VerticalScrollBarVisibility="Visible" AllowAutoHide="False">
            <ItemsControl ItemsSource="{Binding Filters}" IsEnabled="{Binding !IsBusy}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:LogFilter">
                  <Border Background="#F3F5F8" CornerRadius="3" Padding="6,2" Margin="0,0,0,2">
                    <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="70,*,140,Auto,Auto" ColumnSpacing="6">
                      <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Text}" />
                      <TextBlock Grid.Column="2" Text="{Binding CaseLabel}" FontSize="11" Foreground="#526174" VerticalAlignment="Center" />
                      <Button Grid.Column="3" Name="AddConditionButton" Content="Добавить условие…" Click="AddCondition_Click" Padding="8,2" />
                      <Button Grid.Column="4" Name="RemoveFilterButton" Content="Удалить" Click="Remove_Click" Padding="8,2" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding AdditionalConditions}" Margin="20,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:LogFilterCondition">
                          <Grid ColumnDefinitions="90,*,140,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                            <TextBlock Text="И содержит" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Text}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding CaseLabel}" FontSize="11"
                                       Foreground="#526174" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Name="RemoveConditionButton" Content="Удалить"
                                    Click="RemoveCondition_Click" Padding="8,2" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="Фильтров пока нет — показаны все строки" IsVisible="{Binding HasNoFilters}"
                     IsHitTestVisible="False" Foreground="#738297" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
      </Grid>
        </TabItem>
        <TabItem Header="Статистика" Name="StatisticsTab">
          <views:StatisticsPanel DataContext="{Binding Statistics}" />
        </TabItem>
      </TabControl>
    </Border>

    <StackPanel Grid.Row="4" Spacing="2">
      <TextBlock Text="{Binding Status}" Foreground="#526174" FontSize="11" TextWrapping="Wrap" />
      <TextBlock Text="{Binding GroupingWarning}" IsVisible="{Binding HasGroupingWarning}" Foreground="#986000" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#B42318" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
