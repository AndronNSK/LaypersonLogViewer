<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LaypersonLogViewer.App.Views.TimestampPatternDialog"
        Title="Начало записи по времени" Width="580" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock Text="Начало записи по времени" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="Выделенный образец:" />
    <TextBox Name="ExampleBox" IsReadOnly="True" FontFamily="Consolas, monospace" />
    <TextBlock Name="PatternDescription" TextWrapping="Wrap" FontFamily="Consolas, monospace" />
    <TextBlock Text="Каждый # в шаблоне — любая цифра 0–9. Остальные символы и позиция в строке должны совпадать. Значение даты не проверяется."
               TextWrapping="Wrap" Foreground="#526174" />
    <TextBlock Name="PreviewCount" FontWeight="SemiBold" />
    <TextBlock Text="Совпавшая строка начинает новую запись. Следующие строки относятся к ней до нового совпадения. Фильтры будут применяться ко всей записи; исключение в любой строке скрывает запись целиком."
               TextWrapping="Wrap" />
    <TextBlock Text="Выбирайте временную метку с постоянным числом символов. Если образец выбран неверно, отмените диалог и выделите время заново."
               TextWrapping="Wrap" FontSize="12" Foreground="#526174" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="CancelButton" Content="Отмена" IsCancel="True" Click="Cancel_Click" />
      <Button Name="ApplyButton" Content="Применить" IsDefault="True" Click="Apply_Click" />
    </StackPanel>
  </StackPanel>
</Window>
